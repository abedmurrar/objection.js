{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!doc/.vitepress/dist",
      "!doc/.vitepress/cache",
      "!package-lock.json",
      "!**/*.pegjs"
    ]
  },
  "formatter": {
    "enabled": true,
    // Code and JSON only, as with prettier. The Markdown formatter would drop
    // the trailing spaces that are line breaks.
    "includes": [
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ts",
      "**/*.mts",
      "**/*.json",
      "**/*.jsonc"
    ],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    // Biome reports `arguments` in ordinary methods as undeclared.
    "globals": ["arguments"],
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        // ESLint's no-undef, the one rule the ESLint config had.
        "noUndeclaredVariables": "error",
        // A function's arity matters here: mocha treats a `done` parameter as
        // a callback test, and knex and objection look at `fn.length` too.
        "noUnusedFunctionParameters": "off",
        // TypeScript's noUnusedLocals takes this over as lib/ is converted.
        "noUnusedVariables": "off"
      },
      "suspicious": {
        // The files are CommonJS, where "use strict" is not redundant. Biome
        // treats .js files as modules and its fix would remove it.
        "noRedundantUseStrict": "off",
        // The query builder is a thenable on purpose: `await Model.query()`.
        "noThenProperty": "off",
        // `x !== x` is the NaN check of SameValueZero (cloneDeep).
        "noSelfCompare": "off",
        // The loose comparisons are deliberate (ids compared across types),
        // and the fix would change which values match.
        "noDoubleEquals": "off",
        // isNaN() and Number.isNaN() differ for non-numbers.
        "noGlobalIsNan": "off",
        // Local constants like `const toString = Object.prototype.toString`.
        "noShadowRestrictedNames": "off",
        // Mocha files register several hooks of the same kind on purpose.
        "noDuplicateTestHooks": "off",
        // The public typings and the type tests use `any` where it's meant.
        "noExplicitAny": "off",
        // Typings use `void` in union return types on purpose.
        "noConfusingVoidType": "off",
        // forEach callbacks written as `(x) => fn(x)` return a value, harmlessly.
        "useIterableCallbackReturn": "off",
        // A couple of `while ((m = re.exec(s)))` loops and lazy caches.
        "noAssignInExpressions": "off",
        // The parsers match control characters on purpose.
        "noControlCharactersInRegex": "off",
        // Type tests check declaration merging and implicit any on purpose.
        "noUnsafeDeclarationMerging": "off",
        "noImplicitAnyLet": "off",
        // A test reassigns its model classes to check the related queries.
        "noClassAssign": "off"
      },
      "complexity": {
        // `this` in static methods is how Model subclasses work. The fix
        // would replace it with the class name, which breaks inheritance.
        "noThisInStatic": "off",
        // `a && a.b` and `a?.b` differ when `a` is 0, '' or false.
        "useOptionalChain": "off",
        // `arguments` goes away as lib/ is converted to TypeScript.
        "noArguments": "off",
        // Style preferences, not bugs.
        "useArrowFunction": "off",
        "noUselessThisAlias": "off",
        "noBannedTypes": "off",
        "noStaticOnlyClass": "off"
      },
      "style": {
        // Style preferences, not bugs.
        "useTemplate": "off",
        "useShorthandFunctionType": "off",
        "noNonNullAssertion": "off"
      },
      "performance": {
        // Two reduce() calls over a handful of items.
        "noAccumulatingSpread": "off"
      }
    }
  },
  "overrides": [
    {
      // Generated by PEG.js from the .pegjs files.
      "includes": ["src/queryBuilder/parsers/*Parser.js"],
      "linter": { "enabled": false }
    },
    {
      "includes": ["tests/**", "testUtils/**", "bench/**", "examples/**/tests.js"],
      "javascript": {
        "globals": [
          "arguments",
          "describe",
          "it",
          "before",
          "after",
          "beforeEach",
          "afterEach",
          "context"
        ]
      }
    }
  ]
}
