{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "types": ["node"]
  },
  "include": ["tests/ts/**/*.ts", "tests/ts/**/*.mts"]
}
