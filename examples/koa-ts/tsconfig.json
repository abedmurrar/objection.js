{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "allowJs": true,
    "target": "es2023",
    "types": ["node"],
    "rootDir": "./",
    "outDir": "dist"
  }
}
