{
  "name": "@amurrar/objection",
  "version": "3.1.5",
  "description": "An SQL-friendly ORM for Node.js. A fork of objection.js with strict TypeScript types and MySQL support.",
  "main": "lib/objection.js",
  "license": "MIT",
  "scripts": {
    "test": "npm run eslint && mocha --slow 10 --timeout 15000 --reporter spec --recursive tests --exclude \"tests/unit/relations/files/**\" && npm run test:typings",
    "test:fast": "mocha --slow 10 --timeout 15000 --reporter spec --recursive tests --bail --exclude \"tests/unit/relations/files/**\"",
    "test:typings": "node scripts/generate-fn-typings.js --check && tsc && tsc -p tests/ts/tsconfig.loose.json && node scripts/typings-errors.js",
    "test:typings:ts7": "npx -y -p typescript@7 tsc -p tests/ts/tsconfig.ts7.json",
    "bench:typings": "node scripts/typings-bench.js",
    "prettier": "prettier --write \"{examples,lib,tests,testUtils,typings,doc}/**/*.{js,ts}\"",
    "eslint": "eslint --format codeframe \"examples/**/*.js\" \"lib/**/*.js\" \"tests/**/*.js\"",
    "docs:dev": "vuepress dev doc",
    "docs:build": "vuepress build doc",
    "release": "node scripts/release.js",
    "prepublishOnly": "npm run eslint && npm run test:typings"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Abed Murrar",
    "url": "https://github.com/abedmurrar"
  },
  "contributors": [
    "Sami Koskimäki <sami@jakso.me> (https://github.com/koskimas)",
    "Mikael Lepistö <mikael.lepisto@vincit.com> (https://github.com/elhigu)",
    "Matthew McEachen <matthew-objection@photostructure.com> (https://github.com/mceachen)",
    "Jürg Lehni <juerg@scratchdisk.com> (https://github.com/lehni)",
    "Igor Savin <kibertoad@gmail.com> (https://github.com/kibertoad)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abedmurrar/objection.js.git"
  },
  "bugs": {
    "url": "https://github.com/abedmurrar/objection.js/issues"
  },
  "homepage": "https://github.com/abedmurrar/objection.js#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "keywords": [
    "orm",
    "knex",
    "sql",
    "query",
    "query builder",
    "postgresql",
    "mysql",
    "sqlite3"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "lib/*",
    "typings/*"
  ],
  "types": "./typings/objection/index.d.ts",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "db-errors": "^0.2.3"
  },
  "peerDependencies": {
    "knex": ">=3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "chai": "^4.3.10",
    "chai-subset": "^1.6.0",
    "eslint": "^8.54.0",
    "eslint-formatter-codeframe": "^7.32.1",
    "eslint-plugin-prettier": "^5.3.1",
    "expect.js": "^0.3.1",
    "knex": "^3.3.0",
    "mocha": "^11.2.2",
    "mysql2": "^3.24.6",
    "pg": "^8.15.6",
    "prettier": "3.5.3",
    "sqlite3": "^5.1.7",
    "typescript": "~5.8.3",
    "vuepress": "1.9.10"
  }
}
