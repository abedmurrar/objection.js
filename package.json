{
  "name": "@abedmurrar/objection",
  "version": "4.0.0-beta.7",
  "description": "An SQL-friendly ORM for Node.js. A fork of objection.js with strict TypeScript types and MySQL support.",
  "main": "lib/objection.js",
  "type": "commonjs",
  "types": "./typings/objection/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./typings/objection/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./typings/objection/index.d.ts",
        "default": "./lib/objection.js"
      }
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "npm run lint && mocha --slow 10 --timeout 15000 --reporter spec --recursive tests --exclude \"tests/unit/relations/files/**\" && npm run test:typings",
    "pretest:fast": "npm run build",
    "test:fast": "mocha --slow 10 --timeout 15000 --reporter spec --recursive tests --bail --exclude \"tests/unit/relations/files/**\"",
    "test:typings": "npm run build && node scripts/generate-fn-typings.js --check && node scripts/generate-esm-typings.js --check && tsc && tsc -p tests/ts/tsconfig.loose.json && node scripts/typings-errors.js && attw --pack .",
    "bench:typings": "node scripts/typings-bench.js",
    "prebench": "npm run build",
    "bench": "node bench/run.js",
    "prebench:compare": "npm run build",
    "bench:compare": "node bench/compare.js",
    "format": "biome check --write",
    "lint": "biome check",
    "docs:dev": "vitepress dev doc",
    "docs:build": "vitepress build doc",
    "docs:preview": "vitepress preview doc",
    "release": "node scripts/release.js",
    "prepublishOnly": "npm run build && npm run lint && npm run test:typings",
    "sql-check": "npm run build && node bench/sql-check.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Abed Murrar",
    "url": "https://github.com/abedmurrar"
  },
  "contributors": [
    "Sami Koskimäki <sami@jakso.me> (https://github.com/koskimas)",
    "Mikael Lepistö <mikael.lepisto@vincit.com> (https://github.com/elhigu)",
    "Matthew McEachen <matthew-objection@photostructure.com> (https://github.com/mceachen)",
    "Jürg Lehni <juerg@scratchdisk.com> (https://github.com/lehni)",
    "Igor Savin <kibertoad@gmail.com> (https://github.com/kibertoad)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abedmurrar/objection.js.git"
  },
  "bugs": {
    "url": "https://github.com/abedmurrar/objection.js/issues"
  },
  "homepage": "https://github.com/abedmurrar/objection.js#readme",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "orm",
    "knex",
    "sql",
    "query",
    "query builder",
    "postgresql",
    "mysql",
    "sqlite3"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "lib/**/*.js",
    "lib/**/*.mjs",
    "typings/*"
  ],
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "db-errors": "^0.2.3"
  },
  "peerDependencies": {
    "knex": ">=3.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.19.2",
    "chai": "^6.3.0",
    "chai-subset": "^1.6.0",
    "expect.js": "^0.3.1",
    "knex": "^3.3.0",
    "mariadb": "^3.5.4",
    "mocha": "^12.0.3",
    "mysql2": "^3.24.6",
    "pg": "^8.15.6",
    "sqlite3": "^6.0.1",
    "typescript": "^7.0.2",
    "vitepress": "2.0.0-alpha.21"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
