{
  // Compiles src/ into lib/, which is what the package ships and the tests
  // run. The public types are still the hand-written typings/ for now.
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noImplicitReturns": true,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "declaration": false,
    "newLine": "lf",
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
